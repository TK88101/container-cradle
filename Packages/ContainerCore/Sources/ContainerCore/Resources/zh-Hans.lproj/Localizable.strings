/* ContainerCore zh-Hans（Day 14）。key = 英文源串（代码里的字面量）。
   计数类条目在 zh 无复数变形，普通条目即可（en 的复数在 en.lproj/Localizable.stringsdict）。 */

/* ===== ContainerStatePresentation ===== */
"Running" = "运行中";
"Stopped" = "已停止";
"Stopping" = "停止中";
"Unknown" = "未知";

/* ===== SupervisorPresentation.headline ===== */
"Checking runtime…" = "正在检查运行时…";
"Runtime is not running" = "运行时未运行";
"Runtime OK (cold start, hands off)" = "运行时正常（冷启动，未代劳）";
"Runtime OK · managed containers started" = "运行时正常 · 受管容器已拉起";
"Starting managed containers…" = "正在拉起受管容器…";
"Start failed, waiting to retry (failed %lld times)" = "拉起失败，等待重试（已失败 %lld 次）";
"Circuit open · automatic retries stopped" = "已熔断 · 自动重试已停止";

/* ===== SupervisorPresentation.detail / reason ===== */
"%@ · retried %lld times" = "%1$@ · 已重试 %2$lld 次";
"Failed %lld times in a row; automatic retries stopped. Once fixed, choose \"Start managed containers now\" from the menu." = "连续失败 %lld 次，已停止自动重试。修好之后请在菜单里点「立即启动受管容器」。";
"A whitelisted container does not exist (typo in the ID? Or was it deleted?). Check the whitelist." = "白名单里有容器不存在（ID 拼错了？或者容器被删了）。请检查白名单。";
"No runtime to start containers on — start the apple/container runtime first." = "现在没有运行时可拉——先把 apple/container 的运行时启动起来。";
"Waiting for mount source (external disk / network volume not attached yet?)" = "等待挂载源就绪（外置盘 / 网络卷还没挂上？）";
"Start failed (container crashes right after boot?)" = "启动失败（容器起来就崩？）";
"Container not found" = "容器不存在";

/* ===== SystemNotificationContent ===== */
"Automatic restart stopped" = "自动重启已停止";
"Managed containers failed %lld times in a row; the circuit is now open. Once fixed, choose \"Start managed containers now\" from the menu." = "受管容器连续失败 %lld 次，已熔断。修好之后请在菜单里点「立即启动受管容器」。";
"A whitelisted container is missing" = "白名单里有容器不存在";
"A managed container cannot start (typo in the ID? Or was it deleted?). Check the whitelist." = "有受管容器起不来（ID 拼错了？或者容器被删了）。请检查白名单。";

/* ===== ContainerActionPresentation ===== */
"Stop failed: %@" = "停止失败：%@";
"Start failed: %@" = "启动失败：%@";
"Restart failed (stop phase failed; the container is still running): %@" = "重启失败（停止阶段失败，容器仍在运行）：%@";
"Stopped, but start failed: %@" = "已停止，但启动失败：%@";
"The container runtime is not running" = "容器运行时没在运行";
"Container %@ not found. It may have been deleted." = "找不到容器 %@。它可能已被删除。";
"%@ does not exist on the host yet. An external disk or network volume may not be attached." = "宿主上的 %@ 还不存在。外置盘或网络卷可能还没挂上。";

/* ===== VolumePresentation：四象限（永远双数或明示 unknown，R7） ===== */
"size unknown" = "大小未知";
"%@ used / max unknown" = "已用 %1$@ / 上限未知";
"used unknown / %@ max" = "已用未知 / 上限 %1$@";
"%@ used / %@ max" = "已用 %1$@ / 上限 %2$@";

/* ===== VolumePresentation.deletionImpact ===== */
"Volume: %@" = "卷：%@";
"Used: %@" = "已用：%@";
"Used: unknown — size fetch failed" = "已用：未知——大小获取失败";
"Source: %@" = "来源：%@";
"Created: %@" = "创建于：%@";
"This volume's data cannot be recovered after deletion." = "删除后卷内数据无法恢复。";

/* ===== spike golden pattern（app 侧 count 文案的 core 验证样板） ===== */
