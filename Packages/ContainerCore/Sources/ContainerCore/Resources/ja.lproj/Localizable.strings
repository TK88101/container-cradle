/* ContainerCore ja（Day 14 草稿——substantial 句已过 /humanmade）。key = 英文源串。 */

/* ContainerStatePresentation */
"Running" = "実行中";
"Stopped" = "停止";
"Stopping" = "停止処理中";
"Unknown" = "不明";

/* SupervisorPresentation.headline */
"Checking runtime…" = "ランタイムを確認中…";
"Runtime is not running" = "ランタイムが実行されていません";
"Runtime OK (cold start, hands off)" = "ランタイム正常（コールドスタート・自動起動なし）";
"Runtime OK · managed containers started" = "ランタイム正常 · 管理対象コンテナを起動しました";
"Starting managed containers…" = "管理対象コンテナを起動中…";
"Start failed, waiting to retry (failed %lld times)" = "起動に失敗、再試行を待機中（%lld 回失敗）";
"Circuit open · automatic retries stopped" = "遮断中 · 自動再試行を停止しました";

/* SupervisorPresentation.detail / reason */
"%@ · retried %lld times" = "%1$@ · %2$lld 回再試行";
"Failed %lld times in a row; automatic retries stopped. Once fixed, choose \"Start managed containers now\" from the menu." = "%lld 回連続で失敗したため、自動再試行を停止しました。復旧したら、メニューの「管理対象コンテナを今すぐ起動」を選んでください。";
"A whitelisted container does not exist (typo in the ID? Or was it deleted?). Check the whitelist." = "ホワイトリストに存在しないコンテナがあります（ID の入力ミス、または削除された可能性）。内容を確認してください。";
"No runtime to start containers on — start the apple/container runtime first." = "起動先のランタイムがありません。先に apple/container のランタイムを起動してください。";
"Waiting for mount source (external disk / network volume not attached yet?)" = "マウント元を待機中（外付けディスクやネットワークボリュームが未接続では？）";
"Start failed (container crashes right after boot?)" = "起動に失敗（コンテナが起動直後にクラッシュ？）";
"Container not found" = "コンテナが見つかりません";

/* SystemNotificationContent */
"Automatic restart stopped" = "自動再起動を停止しました";
"Managed containers failed %lld times in a row; the circuit is now open. Once fixed, choose \"Start managed containers now\" from the menu." = "管理対象コンテナが %lld 回連続で失敗し、遮断状態になりました。復旧したら、メニューの「管理対象コンテナを今すぐ起動」を選んでください。";
"A whitelisted container is missing" = "ホワイトリストのコンテナが見つかりません";
"A managed container cannot start (typo in the ID? Or was it deleted?). Check the whitelist." = "管理対象コンテナを起動できません（ID の入力ミス、または削除された可能性）。ホワイトリストを確認してください。";

/* ContainerActionPresentation */
"Stop failed: %@" = "停止に失敗：%@";
"Start failed: %@" = "起動に失敗：%@";
"Restart failed (stop phase failed; the container is still running): %@" = "再起動に失敗（停止に失敗し、コンテナは実行中のまま）：%@";
"Stopped, but start failed: %@" = "停止しましたが、起動に失敗：%@";
"The container runtime is not running" = "コンテナランタイムが実行されていません";
"Container %@ not found. It may have been deleted." = "コンテナ %@ が見つかりません。削除された可能性があります。";
"%@ does not exist on the host yet. An external disk or network volume may not be attached." = "ホスト上に %@ がまだ存在しません。外付けディスクやネットワークボリュームが未接続の可能性があります。";

/* VolumePresentation 四象限 */
"size unknown" = "サイズ不明";
"%@ used / max unknown" = "使用中 %1$@ / 上限不明";
"used unknown / %@ max" = "使用中不明 / 上限 %1$@";
"%@ used / %@ max" = "使用中 %1$@ / 上限 %2$@";

/* VolumePresentation.deletionImpact */
"Volume: %@" = "ボリューム：%@";
"Used: %@" = "使用中：%@";
"Used: unknown — size fetch failed" = "使用中：不明——サイズの取得に失敗";
"Source: %@" = "ソース：%@";
"Created: %@" = "作成：%@";
"This volume's data cannot be recovered after deletion." = "削除後、このボリュームのデータは復元できません。";

"%lld volumes" = "%lld 個のボリューム";

/* ===== ContainerActionPresentation：Day 16 T9.10 で補った delete の債務 ===== */
"Delete failed: %@" = "削除に失敗しました：%@";

/* ===== ContainerCreationPresentation：フォームの入力エラー（Day 16 T9.5） ===== */
"Enter a container name" = "コンテナ名を入力してください";
"Container names may only contain letters, digits, dots, dashes and underscores" = "コンテナ名に使えるのは英数字とピリオド・ハイフン・アンダースコアだけです";
"Enter an image reference, for example nginx:latest" = "イメージ参照を入力してください（例：nginx:latest）";
"Mount path %@ must start with a slash" = "マウントパス %@ はスラッシュで始めてください";
"Mount path %@ must not contain a colon" = "マウントパス %@ にコロンは使えません";
"Mount path %@ is used more than once" = "マウントパス %@ が重複しています";
"%@ is not a valid volume name" = "%@ はボリューム名として使えません";
"An environment variable name is empty" = "環境変数名が空のままです";
"Environment variable name %@ must not contain an equals sign" = "環境変数名 %@ に等号は使えません";
"Environment variable %@ is set more than once" = "環境変数 %@ が重複しています";

/* ===== ContainerCreationPresentation：create / clone の送信失敗 ===== */
"A container named %@ already exists" = "%@ という名前のコンテナはすでにあります";
"Could not check existing containers, so nothing was created: %@" = "既存のコンテナを確認できなかったため、何も作成していません：%@";
"Create failed: %@" = "作成に失敗しました：%@";
"Container %@ was created and kept as stopped; starting it failed: %@" = "コンテナ %1$@ は作成され、停止状態のまま残っています。起動には失敗しました：%2$@";
"Give the clone a different name from the source container" = "クローンには元のコンテナと違う名前を付けてください";
"Clone failed: %@" = "クローンに失敗しました：%@";
"Could not load the source container configuration: %@" = "コピー元コンテナの設定を読み込めませんでした：%@";

/* ===== ImagePullPresentation（Day 16 T9.5） ===== */
"Could not start the pull: %@" = "取得を開始できませんでした：%@";
"The pull was interrupted: %@" = "取得が中断されました：%@";
"Enter an image reference to pull" = "取得するイメージ参照を入力してください";
"Pulling %@…" = "%@ を取得しています…";
"Stopped waiting for %@; it may still be downloading" = "%@ の待機をやめました。バックグラウンドではまだ取得中かもしれません";
"%@ failed: %@" = "%1$@ が失敗しました：%2$@";
"Pulled %@" = "%@ を取得しました";
