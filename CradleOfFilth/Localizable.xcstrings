{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@?" : {
      "comment" : "Confirmation dialog title: <verb> <container id>?",
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ %2$@？" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ %2$@？" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ %2$@？" } }
      }
    },
    "%lld images" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld image" } },
              "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld images" } }
            }
          }
        },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%lld 個のイメージ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 个镜像" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%lld 個映像檔" } }
      }
    },
    "%lld of %lld items" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%lld / %lld 件" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld / %lld 项" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%lld / %lld 項" } }
      }
    },
    "%lld volumes" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld volume" } },
              "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld volumes" } }
            }
          }
        },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%lld 個のボリューム" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 个 volume" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%lld 個 volume" } }
      }
    },
    "%@ does not exist on the host yet. An external disk or network volume may not be attached — it will retry automatically once mounted." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホスト上に %@ がまだ存在しません。外付けディスクやネットワークボリュームが未マウントの可能性があります。マウントされ次第、自動的に再試行します。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "宿主上的 %@ 还不存在。外置盘或网络卷可能还没挂上——挂上之后会自动重试。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "主機上的 %@ 還不存在。外接磁碟或網路磁碟區可能還沒掛載——掛載之後會自動重試。" } }
      }
    },
    "%lld volumes, %lld bind, %lld tmpfs" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ボリューム %lld・bind %lld・tmpfs %lld" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 个 volume、%lld 个 bind、%lld 个 tmpfs" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%lld 個 volume、%lld 個 bind、%lld 個 tmpfs" } }
      }
    },
    "(no environment variables)" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "（環境変数なし）" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "（没有环境变量）" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "（沒有環境變數）" } }
      }
    },
    "A managed container won’t auto-restart after you stop it manually (unless the container runtime restarts; if the supervisor is currently auto-starting, the container may be restarted right after)." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "管理対象のコンテナは手動で停止しても自動再起動しません（コンテナランタイムが再起動した場合を除く。スーパーバイザーが自動起動中の場合は、直後に再起動されることがあります）。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "受管容器手动停止后不会自动重启（除非容器运行时重启；若 supervisor 正在自动拉起，容器可能随后被重启）。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "受管容器手動停止後不會自動重啟（除非容器執行階段重啟；若 supervisor 正在自動拉起，容器可能隨後被重啟）。" } }
      }
    },
    "A volume with this name was changed externally during confirmation (possibly deleted and recreated). The list has refreshed; please verify and start the deletion again." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この名前のボリュームは確認中に外部から変更されました（削除して再作成された可能性があります）。リストを更新しました。確認のうえ、削除をやり直してください。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这个名字的卷在确认期间被外部改动过（可能被删除重建）。列表已刷新，请核对后重新发起删除。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這個名字的磁碟區在確認期間被外部改動過（可能被刪除重建）。清單已重新整理，請核對後重新發起刪除。" } }
      }
    },
    "Add Variable" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "変数を追加" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加变量" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "新增變數" } }
